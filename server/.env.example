# Copia questo file in server/.env sul NAS (mai nel repo) oppure usa nas/imposta-chiave.sh.
# Senza LECTIO_MISTRAL_KEY il server gira in modalità prova (testo finto, voce robotica, costi 0).
# La chiave di Tailscale (TS_AUTHKEY) NON va qui: sta in tailscale/.env, che vede solo il
# container di Tailscale.
LECTIO_MISTRAL_KEY=
LECTIO_AZURE_KEY=
LECTIO_AZURE_REGIONE=
# L'indirizzo https di Lectio fuori casa (Tailscale Funnel), per esempio https://lectio.<rete>.ts.net:
# il server lo comunica alle app all'abbinamento e in /api/salute.
LECTIO_INDIRIZZO_FUORI_CASA=
# Facoltativi (si lasciano vuoti per usare i valori predefiniti):
LECTIO_MODELLO_PIANO=
LECTIO_MODELLO_SCRITTURA=
LECTIO_MODELLO_OCR=
LECTIO_MODELLO_VOCE=
LECTIO_VOCE_MISTRAL=
