<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 e oltre: niente copia nel cloud e niente trasferimento su un altro
     telefono. Dentro ci sono il token (cifrato, inutile altrove), le lezioni e le
     risposte: su un telefono nuovo si rifà l'abbinamento. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
